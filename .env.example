# OpenRouter API key for AI features
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Authentication (set to 'true' to enable Firebase Auth)
AUTH_ENABLED=false

# Firebase Admin SDK (required when AUTH_ENABLED=true)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client config (served to frontend via /api/auth/config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
